{
  "name": "kumakatok",
  "version": "1.0.4",
  "description": "",
  "author": "Codica",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "PRETTY_LOGGING=true nest start --watch",
    "start:debug": "PRETTY_LOGGING=true nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:perf": "PERFORMANCE_TESTING=true node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:swagger": "rm -rf swagger && ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/generate-swagger.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "docker:deps": "docker compose up -d",
    "start:al": "concurrently  -n \"docker,backend\" -c \"blue,green\" \"docker compose up\" \"pnpm start\"",
    "stop:services": "concurrently \"docker compose down\" \"redis-cli shutdown\" \"pg_ctl stop\"",
    "start:all": "ts-node -r tsconfig-paths/register --project tsconfig.json ./src/infrastructure/scripts/concurrent-services.ts",
    "docker:down": "docker compose down",
    "stripe:webhook": "stripe listen --forward-to http://localhost:3000/webhooks/stripe",
    "db:seed:attribute-definitions": "ts-node -r tsconfig-paths/register --project tsconfig.json ./prisma/seed/attribute-definitions.ts",
    "db:seed:listings": "ts-node -r tsconfig-paths/register --project tsconfig.json ./prisma/seed/listings.ts",
    "db:seed:admin": "ts-node -r tsconfig-paths/register --project tsconfig.json ./prisma/seed/create-admin.ts",
    "db:seed:production:admin": "node ./dist/prisma/seed/create-admin.js",
    "db:seed:production:listings": "node ./dist/prisma/seed/listings.js",
    "db:seed:production:attribute-definitions": "node ./dist/prisma/seed/attribute-definitions.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org codica --project kumakatok-nestjs ./dist/src && sentry-cli sourcemaps upload --org codica --project kumakatok-nestjs ./dist/src",
    "update:user-types": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/update-user-types.ts",
    "update:elasticsearch-fields": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/update-elasticsearch-fields.ts",
    "update:database-fields": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/update-database-fields.ts",
    "sync:elasticsearch-listings": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/sync-listings-to-elasticsearch.ts",
    "migration:appsearch-to-elasticsearch": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/migrate-appsearch-to-elasticsearch.ts",
    "migration:appsearch-to-elasticsearch:prod": "node ./dist/scripts/migrate-appsearch-to-elasticsearch.js",
    "migration:slugs": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/migrate-slugs-production.ts",
    "migration:slugs:prod": "node ./dist/scripts/migrate-slugs-production.js",
    "migration:slugs:rollback": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/rollback-slug-migration.ts",
    "migration:slugs:rollback:prod": "node ./dist/scripts/rollback-slug-migration.js",
    "migration:staycation-price": "ts-node -r tsconfig-paths/register --project tsconfig.json ./scripts/update-staycation-price-without-commission.ts",
    "migration:staycation-price:prod": "node ./dist/scripts/update-staycation-price-without-commission.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/client-textract": "^3.649.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@elastic/elasticsearch": "^8.18.2",
    "@elastic/enterprise-search": "^8.6.1",
    "@mailchimp/mailchimp_transactional": "^1.0.59",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^11.1.2",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.0.1",
    "@nestjs/websockets": "^11.1.2",
    "@oslojs/otp": "^1.0.0",
    "@prisma/client": "^6.0.1",
    "@sendgrid/mail": "^8.1.4",
    "@sentry/cli": "^2.41.1",
    "@sentry/esbuild-plugin": "^3.0.0",
    "@sentry/nestjs": "^8.50.0",
    "@sentry/profiling-node": "^8.50.0",
    "argon2": "^0.41.1",
    "axios": "^1.12.2",
    "dotenv": "^17.2.0",
    "express": "^4.21.1",
    "express-basic-auth": "^1.2.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.1",
    "install": "^0.13.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nanoid": "^5.1.5",
    "nestjs-zod": "^4.2.0",
    "pg": "^8.12.0",
    "pino": "^9.7.0",
    "ra-data-simple-prisma": "^5.2.1",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@jest/types": "^29.6.3",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/testing": "^10.0.0",
    "@scalar/nestjs-api-reference": "^0.4.14",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mailchimp__mailchimp_transactional": "^1.0.10",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autocannon": "^8.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^1.7.1",
    "express-rate-limit": "^7.3.1",
    "jest": "^29.5.0",
    "nodemailer": "^6.9.16",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(nanoid)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@auth/(.*)$": "<rootDir>/src/infrastructure/auth/$1",
      "^@common/(.*)$": "<rootDir>/src/infrastructure/common/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@presentation/(.*)$": "<rootDir>/src/presentation/$1",
      "^@use-cases/(.*)$": "<rootDir>/src/use-cases/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^~/(.*)$": "<rootDir>/src/$1",
      "^nanoid$": "<rootDir>/tests/mocks/nanoid.mock.ts"
    },
    "setupFiles": [
      "<rootDir>/tests/setup/env.ts"
    ]
  }
}